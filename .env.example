# Copy this file's variable names into your hosting provider's Environment settings.
# Never commit a real .env file with actual secrets to GitHub.

# Supabase Postgres connection string.
# Supabase dashboard -> Project Settings -> Database -> Connection string
# -> "Connection pooling" tab -> URI (use the POOLER string, port 6543,
# not the direct :5432 one — works better through the pooler for many
# short-lived connections).
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Telegram bot token from @BotFather (kept server-side only — never sent to the browser)
TG_BOT_TOKEN=123456:ABC-your-bot-token

# Your Telegram chat id (message your bot once, then fetch
# https://api.telegram.org/bot<token>/getUpdates to find it)
TG_CHAT_ID=987654321

# How often (ms) the server polls Delta Exchange and checks alerts. 2000 = 2s,
# matches the live dashboards. Lower = faster alerts but more API calls.
POLL_MS=2000
